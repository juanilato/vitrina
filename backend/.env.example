# Database
DATABASE_URL=postgresql://user:password@localhost:5432/vitrina
DIRECT_URL=postgresql://user:password@localhost:5432/vitrina

# JWT
JWT_SECRET=your-secret-key-here

# Server
PORT=3001
NODE_ENV=development

# Frontend URL (para CORS y callbacks)
FRONTEND_URL=http://localhost:3000

# Backend URL (para webhooks)
BACKEND_URL=http://localhost:3001

# MercadoPago
# Obtén tus credenciales en: https://www.mercadopago.com.ar/developers/panel/credentials
# Para desarrollo, usa las credenciales de TEST
# Para producción, usa las credenciales de PRODUCCIÓN
MERCADOPAGO_ACCESS_TOKEN=TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google OAuth (opcional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (opcional)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
