generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}



// ——— Cuenta cliente ———
model Cliente {
  id          String    @id @default(cuid())
  email       String    @unique
  name        String
  password    String
  isVerified  Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  Pedidos     Pedido[]
}

// ——— Cuenta empresa ———
model Empresa {
  id          String     @id @default(cuid())
  email       String     @unique
  name        String
  password    String
  logo        String?    
  ubicacion   Ubicacion?
  isVerified  Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  alias         String?          
  redesSociales Json?      
  preferenciasWeb Preferencias?
  productos   Productos[]
  Pedidos     Pedido[]
}
enum DayOfWeek {
  LUN
  MAR
  MIE
  JUE
  VIE
  SAB
  DOM
}
model Preferencias {
  // hacemos 1:1 usando el mismo id que Empresa
  empresaId       String        @id
  empresa         Empresa       @relation(fields: [empresaId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  // personalización UI
  colorBotones    String?       // ej: "#0d6efd"
  colorFondo      String?       // ej: "#ffffff"

  // features
  envioDomicilio  Boolean       @default(false)
  dashboardFoto   String?       // URL en storage

  // relación a horarios
  horarios        HorarioAtencion[]
}

model HorarioAtencion {
  id              Int           @id @default(autoincrement())
  empresaId       String
  preferencias    Preferencias  @relation(fields: [empresaId], references: [empresaId], onDelete: Cascade)

  day             DayOfWeek
  // Soportar corte al mediodía -> múltiples franjas por día
  slotIndex       Int           // 0,1,... para cada franja del día

  // minutos desde medianoche (local)
  abreMin         Int           // ej: 9*60 = 540
  cierraMin       Int           // ej: 13*60 = 780

  // cerrado: no crear filas para ese día; o si querés marcar explícito:
  cerrado         Boolean       @default(false)

  @@unique([empresaId, day, slotIndex])
}
model PreciosEnvio {
  id         Int      @id @default(autoincrement())
  empresaId  String
  precio     Decimal  @db.Decimal(12, 2)
  distancia  Float
  ubicacion    Ubicacion  @relation(fields: [ubicacionId], references: [id])
  ubicacionId Int
  @@unique([ubicacionId, distancia])
}
model Ubicacion {
  id          Int         @id @default(autoincrement())
  empresaId   String      @unique
  direccion   String?
  lat         Float?
  lng         Float?

  empresa     Empresa     @relation(fields: [empresaId], references: [id])
  preciosEnvio PreciosEnvio[]
}

// ——— Productos de empresa ———
model Productos {
  id          String   @id @default(cuid())
  nombre      String
  descripcion String?
  precio      Decimal  @db.Decimal(12, 2)
  fotoUrl    String?    
  fotoPath   String?     
  empresaId   String
  empresa     Empresa  @relation(fields: [empresaId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  activo      Boolean  @default(true)
  @@unique([empresaId, nombre])
  @@index([empresaId])
  ItemPedido ItemPedido[]




  // --- Campos para la gestión de Stock ---
  tipoStock       String         @default("individual") // "individual" o "compuesto"
  // Stock individual: la cantidad en stock de este producto (ej: 50 unidades de hamburguesa)
  stockIndividual Int?           // Nullable si el tipoStock es "compuesto"

  // Flag para permitir que el cliente agregue ingredientes extra al producto
  permiteExtras   Boolean        @default(false)

  // Relación con ingredientes (para stock compuesto o extras)
  ingredientes    ProductoIngrediente[]
}

model Ingrediente {
  id              String         @id @default(cuid())
  nombre          String
  empresaId       String
  // Stock del ingrediente (ej: 10000 gramos de carne, 50 panes)
  stockDisponible Int
  // Unidad de medida (ej: 'gramos', 'unidades', 'ml', etc.)
  unidadMedida    String

  // Relación con los productos que utilizan este ingrediente
  productosUsan   ProductoIngrediente[]
  icono       String? 
  @@unique([empresaId, nombre])
  @@index([empresaId])
}


model ProductoIngrediente {
  id              Int            @id @default(autoincrement())

  productoId      String
  producto        Productos      @relation(fields: [productoId], references: [id], onDelete: Cascade)

  ingredienteId   String
  ingrediente     Ingrediente    @relation(fields: [ingredienteId], references: [id], onDelete: Restrict)

  // Cantidad de este ingrediente que se requiere para UNA unidad del producto.
  // Ej: 200 (gramos) de 'Carne' para 1 'Hamburguesa Clásica'.
  cantidadRequerida Int
 

  // Indica si este ingrediente puede ser añadido como un extra por el cliente (si 'Productos.permiteExtras' es true)
  esExtraPermitido Boolean @default(false)


  @@unique([productoId, ingredienteId])
  @@index([productoId])
  @@index([ingredienteId])
}

// ——— Código de verificación ———
model VerificationCode {
  id              String    @id @default(cuid())
  email           String
  code            String
  userType        String
  expiresAt       DateTime
  isUsed          Boolean   @default(false)
  pendingUserData Json?     // JSON real

  createdAt       DateTime  @default(now())

  @@unique([email, userType, code])
  @@index([email, userType])
  @@index([code])
  @@index([expiresAt])
}

// ——— Pedido ———
model Pedido {
  id         String     @id @default(cuid())

  clienteId  String
  cliente    Cliente    @relation(fields: [clienteId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  empresaId  String
  empresa    Empresa    @relation(fields: [empresaId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  estado     String     @default("pendiente_confirmacion")
  tipoEntrega String    @default("delivery")
  formaPago  String     @default("transferencia")
  motivoRechazo String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  ItemPedido ItemPedido[]
  Mensajes   Mensaje[]

  @@index([clienteId])
  @@index([empresaId])
  @@index([estado, createdAt])
}

// ——— Ítems del pedido ———
model ItemPedido {
  id         String     @id @default(cuid())

  pedidoId   String
  pedido     Pedido     @relation(fields: [pedidoId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  productoId String
  producto   Productos  @relation(fields: [productoId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  cantidad   Int
  precio     Decimal    @db.Decimal(12, 2) 

  @@unique([pedidoId, productoId]) 
  @@index([pedidoId])
  @@index([productoId])
}

// --- Mensajes ---
model Mensaje {
  id             String   @id @default(cuid())

  pedidoId       String
  pedido         Pedido   @relation(fields: [pedidoId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  remitenteId    String   // Puede ser ID de Cliente o Empresa segun remitenteTipo
  remitenteTipo  String   // 'cliente' o 'empresa'

  contenido      String
  enviadoAt      DateTime @default(now())
  leido          Boolean  @default(false)
  leidoAt        DateTime?

  @@index([pedidoId, enviadoAt])
  @@index([remitenteId, remitenteTipo])
}

// --- Notificaciones ---
model Notificacion {
  id          String    @id @default(cuid())
  
  // Usuario que recibe la notificación
  userId      String
  userType    String    // 'cliente' o 'empresa'
  
  // Contenido de la notificación
  titulo      String
  mensaje     String
  tipo        String    // 'pedido_creado', 'pedido_actualizado', 'general', etc.
  
  // Estado de la notificación
  leida       Boolean   @default(false)
  
  // Datos adicionales (JSON)
  metadata    Json?     // Información extra como ID del pedido, etc.
  
  // Timestamps
  createdAt   DateTime  @default(now())
  leidaAt     DateTime?
  
  @@index([userId, userType])
  @@index([leida, createdAt])
  @@index([tipo, createdAt])
}
